---
import { foto, nombreTipo, type Caravana } from "../../data/vallcar";
import { u } from "../../lib/u";

interface Props { c: Caravana }
const { c } = Astro.props;
---
<article class="tarjeta" data-tipo={c.tipo} data-plazas={c.plazas} data-revela>
  <div class="tarjeta-foto">
    <img loading="lazy" src={foto(c.img, 800, 960)} alt={`${c.marca} ${c.modelo}`} width="800" height="960">
    <span class="sello">{nombreTipo[c.tipo]}</span>
  </div>
  <h3><a href={u(`/c/stock/${c.slug}/`)}>{c.modelo}</a></h3>
  <p>{c.plazas} plazas · {c.longitud} · {c.serie}</p>
</article>
