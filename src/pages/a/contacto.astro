---
import LayoutA from "../../layouts/LayoutA.astro";
import Formulario from "../../components/Formulario.astro";
import Visita from "../../components/a/Visita.astro";
import { contacto } from "../../data/vallcar";
import { u } from "../../lib/u";
---
<LayoutA titulo="Contacto y cómo llegar" descripcion="Vallcar en Canovelles (Barcelona): dirección, horario, teléfono y formulario de contacto.">
  <div class="portada">
    <div class="wrap">
      <div class="miga"><a href={u("/a/")}>Inicio</a> / Contacto</div>
      <h1>Contacto y cómo llegar</h1>
      <p class="lead">Estamos en la carretera de Caldes a Canovelles, junto a la C-17. Llámanos, escríbenos o ven a vernos.</p>
    </div>
  </div>

  <Visita />

  <section class="sec sec-gris">
    <div class="wrap dos">
      <div>
        <h2>Escríbenos</h2>
        <p style="margin-top:20px">Para cualquier consulta sobre caravanas, alquiler, taller, parking o tienda. También en <a href={`mailto:${contacto.email}`}>{contacto.email}</a>.</p>
      </div>
      <Formulario titulo="Tu consulta" asunto="Consulta general" />
    </div>
  </section>
</LayoutA>
