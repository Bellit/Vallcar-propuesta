---
import LayoutA from "../../layouts/LayoutA.astro";
import Formulario from "../../components/Formulario.astro";
import Visita from "../../components/a/Visita.astro";
import { alquiler, foto } from "../../data/vallcar";
import { u } from "../../lib/u";
---
<LayoutA titulo="Alquiler de caravanas Sterckeman en Barcelona" descripcion="Alquila una caravana Sterckeman nueva en Canovelles, con todo incluido. Modelos de 4 y 6 plazas.">
  <div class="portada">
    <div class="wrap">
      <div class="miga"><a href={u("/a/")}>Inicio</a> / Alquiler</div>
      <h1>Alquiler de caravanas nuevas</h1>
      <p class="lead">Caravanas Sterckeman nuevas, con todo incluido. Una forma sencilla de hacer camping de vez en cuando, o de probar antes de comprar.</p>
    </div>
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="cabecera-sec"><h2>Modelos disponibles</h2><p>Sujetos a disponibilidad en las fechas que elijas.</p></div>
      <div class="modelos-alq">
        {alquiler.map((m) => (
          <article class="modelo-alq">
            <img src={foto(m.img, 640, 480)} alt={`Sterckeman ${m.modelo}`} loading="lazy" width="640" height="480">
            <div class="cuerpo">
              <h3>{m.modelo}</h3>
              <p><strong>{m.plazas} personas.</strong> {m.camas}.</p>
              <ul>{m.extras.map((e) => <li>{e}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-gris">
    <div class="wrap">
      <h2 style="margin-bottom:32px">Cómo funciona</h2>
      <ol class="pasos">
        <li><b>Pide fechas y modelo</b>Te contesta una persona del equipo, normalmente el mismo día.</li>
        <li><b>Recógela en Canovelles</b>Te explicamos cómo funciona todo y comprobamos el enganche contigo.</li>
        <li><b>Devuélvela y cuéntanos</b>Si os ha convencido, te ayudamos a encontrar la vuestra.</li>
      </ol>
    </div>
  </section>

  <section class="sec">
    <div class="wrap dos">
      <div>
        <h2>Solicita tu alquiler</h2>
        <p style="margin-top:20px">Las reservas las confirman personalmente nuestros responsables de alquiler. No se paga nada hasta la confirmación.</p>
        <ul class="lista-ok">
          <li>Caravana nueva, revisada antes de cada salida</li>
          <li>Equipamiento de cocina y camping incluido</li>
          <li>Asesoramiento sobre campings y rutas</li>
        </ul>
      </div>
      <Formulario titulo="Fechas y modelo" asunto="Solicitud de alquiler" tipo="alquiler" boton="Solicitar alquiler" />
    </div>
  </section>

  <Visita />
</LayoutA>
