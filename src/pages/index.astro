---
import { u } from "../lib/u";

const propuestas = [
  {
    href: u("/a/"),
    letra: "A",
    nombre: "Km 10.2",
    resumen: "Identidad de carretera y concesionario a partir del amarillo de siempre. El stock va primero, con buscador en la portada, y los servicios se presentan como un panel de señalización.",
    prioriza: "Venta y marca de importador nacional",
    colores: ["#FFD100", "#2B2E33", "#1D4F91", "#E9EBEC"],
    tipos: "Archivo",
    captura: u("/capturas/a.png"),
  },
  {
    href: u("/b/"),
    letra: "B",
    nombre: "Plano de planta",
    resumen: "Cálida y familiar. La portada pregunta cuántos vais a dormir dentro: el plano de la caravana marca las camas y la web enseña los modelos que encajan.",
    prioriza: "Nuevos caravanistas y alquiler",
    colores: ["#1F4A3D", "#D6EBF6", "#FFD23F", "#263238"],
    tipos: "Bricolage Grotesque y Atkinson Hyperlegible",
    captura: u("/capturas/b.png"),
  },
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vallcar · Propuestas de rediseño</title>
  <meta name="description" content="Dos propuestas de diseño para la nueva web de Vallcar.">
  <meta name="robots" content="noindex">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;600;800&display=swap" rel="stylesheet">
</head>
<body>
  <main>
    <header>
      <p class="cliente">Vallcar, S.A.</p>
      <h1>Dos propuestas para la nueva web</h1>
      <p class="intro">Las dos son webs navegables con el stock, los modelos de alquiler y los horarios reales. Comparten contenido y tecnología (Astro): solo cambia el diseño y el enfoque. Entra en cada una y prueba los filtros, las fichas y los formularios.</p>
    </header>

    <div class="propuestas">
      {propuestas.map((p) => (
        <a class="propuesta" href={p.href}>
          <div class="captura">
            <img src={p.captura} alt={`Portada de la propuesta ${p.letra}`} loading="lazy" width="1440" height="900">
          </div>
          <div class="texto">
            <div class="nombre"><span class="letra">{p.letra}</span><h2>{p.nombre}</h2></div>
            <p>{p.resumen}</p>
            <dl>
              <div><dt>Prioriza</dt><dd>{p.prioriza}</dd></div>
              <div><dt>Tipografía</dt><dd>{p.tipos}</dd></div>
              <div><dt>Colores</dt><dd class="colores">{p.colores.map((c) => <span style={`background:${c}`} title={c}></span>)}</dd></div>
            </dl>
            <span class="ir">Ver la propuesta {p.letra}</span>
          </div>
        </a>
      ))}
    </div>

    <footer>
      <a href={u("/estudio/")}>Leer el estudio inicial: análisis de la web actual, tecnología y alcance</a>
    </footer>
  </main>
</body>
</html>

<style>
  :root{--fondo:#F6F7F8;--texto:#22262B;--suave:#59616B;--linea:#DDE1E5;--acento:#22262B}
  :global(body){margin:0;background:var(--fondo);color:var(--texto);font-family:"Inter Tight",system-ui,sans-serif;font-size:17px;line-height:1.55}
  main{max-width:1200px;margin:0 auto;padding:clamp(40px,7vw,96px) clamp(16px,4vw,40px)}
  header{max-width:60ch;margin-bottom:clamp(36px,5vw,64px)}
  .cliente{font-weight:600;color:var(--suave);margin:0 0 10px}
  h1{font-size:clamp(38px,5.6vw,68px);line-height:1.02;letter-spacing:-.03em;margin:0 0 20px;font-weight:800}
  .intro{color:var(--suave);font-size:19px;margin:0}
  .propuestas{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,3vw,36px)}
  .propuesta{display:flex;flex-direction:column;background:#fff;border:1px solid var(--linea);border-radius:14px;overflow:hidden;text-decoration:none;color:inherit}
  .propuesta:hover{border-color:var(--acento)}
  .propuesta:focus-visible{outline:3px solid var(--acento);outline-offset:3px}
  .captura{aspect-ratio:16/10;overflow:hidden;border-bottom:1px solid var(--linea);background:var(--linea)}
  .captura img{width:100%;height:100%;object-fit:cover;object-position:top}
  .texto{padding:clamp(20px,3vw,32px);display:flex;flex-direction:column;gap:16px;flex:1}
  .nombre{display:flex;align-items:center;gap:14px}
  .letra{width:44px;height:44px;border-radius:50%;background:var(--texto);color:#fff;display:grid;place-items:center;font-weight:800;font-size:20px;flex:none}
  h2{margin:0;font-size:32px;letter-spacing:-.02em;font-weight:800}
  .texto p{margin:0;color:var(--suave)}
  dl{margin:0;display:grid;gap:8px;font-size:15px}
  dl div{display:grid;grid-template-columns:96px 1fr;gap:12px}
  dt{color:var(--suave)}
  dd{margin:0;font-weight:600}
  .colores{display:flex;gap:6px}
  .colores span{width:26px;height:26px;border-radius:6px;border:1px solid rgba(0,0,0,.12)}
  .ir{margin-top:auto;align-self:flex-start;background:var(--texto);color:#fff;padding:12px 20px;border-radius:999px;font-weight:600}
  footer{margin-top:clamp(36px,5vw,56px);padding-top:24px;border-top:1px solid var(--linea)}
  footer a{font-weight:600}
  @media (max-width:820px){.propuestas{grid-template-columns:1fr}}
</style>
