---
import LayoutC from "../../../layouts/LayoutC.astro";
import Portada from "../../../components/c/Portada.astro";
import Tarjeta from "../../../components/c/Tarjeta.astro";
import Visita from "../../../components/c/Visita.astro";
import { disponibles } from "../../../data/vallcar";
import { u } from "../../../lib/u";
---
<LayoutC titulo="Caravanas en exposición" descripcion="Caravanas Sterckeman nuevas y de ocasión y remolques Comanche en exposición en Canovelles (Barcelona).">
  <Portada miga="Caravanas" titulo="Caravanas en <em>exposición.</em>" lead="Todas están en Canovelles para que entres en ellas. Llegan unidades nuevas cada mes." />

  <section class="sec">
    <div class="wrap">
      <div class="filtros">
        <div class="grupo" role="group" aria-label="Personas">
          <span class="et">Personas</span>
          <button class="chip" data-filtro="plazas" data-valor="0">Todas</button>
          <button class="chip" data-filtro="plazas" data-valor="4">Hasta 4</button>
          <button class="chip" data-filtro="plazas" data-valor="6">5 o más</button>
        </div>
        <div class="grupo" role="group" aria-label="Tipo">
          <span class="et">Tipo</span>
          <button class="chip" data-filtro="tipo" data-valor="todas">Todo</button>
          <button class="chip" data-filtro="tipo" data-valor="nueva">Nuevas</button>
          <button class="chip" data-filtro="tipo" data-valor="ocasion">Ocasión</button>
          <button class="chip" data-filtro="tipo" data-valor="remolque">Remolques</button>
        </div>
        <span class="contador" aria-live="polite"><b data-contador>{disponibles.length}</b> en exposición</span>
      </div>
      <div class="tarjetas" data-stock>
        {disponibles.map((c) => <Tarjeta c={c} />)}
        <div class="vacio" data-vacio hidden>
          <p>Ahora mismo no tenemos ninguna así. Cuéntanos qué buscas y te avisamos cuando llegue.</p>
          <a class="btn btn-oscuro" href={u("/c/contacto/")}>Avisadme</a>
        </div>
      </div>
    </div>
  </section>

  <Visita />
</LayoutC>
