---
import LayoutC from "../../../layouts/LayoutC.astro";
import Tarjeta from "../../../components/c/Tarjeta.astro";
import Formulario from "../../../components/Formulario.astro";
import { disponibles, foto, nombreTipo, type Caravana } from "../../../data/vallcar";
import { u } from "../../../lib/u";

export function getStaticPaths() {
  return disponibles.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Caravana };
const parecidas = disponibles.filter((x) => x.slug !== c.slug && x.plazas === c.plazas).slice(0, 3);
---
<LayoutC titulo={`${c.marca} ${c.modelo}`} descripcion={`${c.marca} ${c.modelo}, ${c.plazas} plazas, ${c.longitud}. ${c.descripcion}`}>
  <section class="portada con-foto ficha" data-progreso="vista">
    <div class="portada-foto"><img src={foto(c.img, 1920, 1200)} alt={`${c.marca} ${c.modelo} en la exposición de Vallcar`} width="1920" height="1200" fetchpriority="high"></div>
    <div class="wrap">
      <p class="miga hero-in" style="--d:.05s"><a href={u("/c/")}>Inicio</a> <span aria-hidden="true">/</span> <a href={u("/c/stock/")}>Caravanas</a> <span aria-hidden="true">/</span> {c.modelo}</p>
      <p class="antetitulo hero-in" style="--d:.1s">{c.marca} · {nombreTipo[c.tipo]}</p>
      <h1 class="hero-in" style="--d:.2s">{c.modelo}</h1>
      <p class="lead hero-in" style="--d:.3s">{c.serie}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <dl class="datos">
        <div data-revela><dt>Personas</dt><dd>{c.plazas}</dd></div>
        <div data-revela style="--d:.08s"><dt>Longitud</dt><dd>{c.longitud}</dd></div>
        <div data-revela style="--d:.16s"><dt>Dónde</dt><dd>Canovelles</dd></div>
      </dl>
      <div class="dos">
        <div>
          <h2 data-revela>{c.distribucion}.</h2>
          <p class="texto-grande" data-revela>{c.descripcion}</p>
          <ul class="lista" data-revela>
            <li>Te la enseñamos por dentro, sin cita</li>
            <li>Entrega revisada en nuestro taller</li>
            <li>Financiación y seguro gestionados por Vallcar</li>
          </ul>
          <p class="aviso" data-revela>Precio y ficha técnica completa, bajo consulta.</p>
        </div>
        <Formulario titulo="Pedir precio" asunto="Pedir precio" tipo="precio" modelo={`${c.modelo} (${c.serie})`} boton="Pedir precio" />
      </div>
    </div>
  </section>

  {parecidas.length > 0 && (
    <section class="sec sec-hueso">
      <div class="wrap">
        <div class="intro"><h2>Otras para {c.plazas} <em>personas.</em></h2><a class="enlace-flecha" href={u("/c/stock/")}>Ver todas <span aria-hidden="true">→</span></a></div>
        <div class="tarjetas">{parecidas.map((x) => <Tarjeta c={x} />)}</div>
      </div>
    </section>
  )}
</LayoutC>
